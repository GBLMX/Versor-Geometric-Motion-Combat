{
	"schemaVersion": 1,
	"id": "versormotion",
	"version": "${version}",
	"name": "Versor Geometric Motion Combat",
	"description": "Geometric algebra combat, rigid-body motion, physical fields, and world editing for Minecraft.",
	"authors": [
		"GBLMX"
	],
	"contact": {
		"homepage": "https://github.com/GBLMX/Versor-Geometric-Motion-Combat",
		"sources": "https://github.com/GBLMX/Versor-Geometric-Motion-Combat",
		"issues": "https://github.com/GBLMX/Versor-Geometric-Motion-Combat/issues"
	},
	"license": "Apache-2.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.gblmx.versormotion.VersorMotion"
		],
		"client": [
			"com.gblmx.versormotion.client.VersorMotionClient"
		],
		"modmenu": [
			"com.gblmx.versormotion.client.VersorModMenu"
		]
	},
	"mixins": [
		{
			"config": "versormotion.mixins.json"
		},
		{
			"config": "versormotion.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": ">=26.3.159"
	},
	"suggests": {
		"modmenu": ">=21.0.0"
	}
}
